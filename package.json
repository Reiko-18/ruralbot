{
  "name": "ruralbot",
  "version": "1.0.0",
  "description": "RuralBot - TypeScript Discord bot with Prisma + PostgreSQL",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run db:generate && npm run build:server && npm run build:dashboard",
    "build:server": "tsc",
    "build:dashboard": "cd dashboard && npm run build",
    "install:dashboard": "cd dashboard && npm ci --include=dev",
    "install:all": "npm ci && npm run install:dashboard",
    "start": "tsx dist/index.js",
    "dev": "tsx src/index.ts",
    "backfill:accounting-threads": "tsx src/scripts/backfill_threads.ts",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:push": "npx prisma db push",
    "db:studio": "npx prisma studio"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [],
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "discord.js": "^14.25.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.5.8",
    "nanoid": "^5.1.7",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-abstract-transport": "^3.0.0",
    "prisma": "^7.8.0",
    "tsx": "^4.21.0"
  },
  "overrides": {
    "@hono/node-server": "1.19.13"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.18.0",
    "@types/pino": "^7.0.4",
    "typescript": "^5.9.3"
  }
}
