# Discord
TOKEN=
DISCORD_TOKEN=
APPLICATION_ID=
# Comma- or whitespace-separated Discord user IDs allowed to run owner-only commands such as /leave.
BOT_OWNER_IDS=
# Comma- or whitespace-separated guild IDs that the bot must leave immediately.
# Guilds 1500125455619985460 and 1515521583169409114 are also blocked in code as emergency defaults.
BLOCKED_GUILD_IDS=1500125455619985460,1515521583169409114
# Optional fallback for accounting thread logs when DB AccountingConfig is missing or stale.
ACCOUNTING_CHANNEL_ID=

# Supabase（管理資訊只保留在本機 .env，不注入 Render runtime）
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PROJECT_REF=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# PostgreSQL / Prisma
# Render 長駐服務使用 Supavisor session pooler；runtime 採 libpq 的 require 語意以維持 TLS 加密。
DATABASE_URL=postgresql://postgres.your-project-ref:change-me@aws-0-your-region.pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require
# Prisma CLI/migration 使用 session pooler，避免 transaction pooler 不支援的操作。
DIRECT_URL=postgresql://postgres.your-project-ref:change-me@aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require

# Dashboard / HTTP
PORT=3000
DASHBOARD_PORT=3000
# Dashboard 存取控制（HTTP Basic Auth）。fail-closed：兩者未同時設定時，
# 除 /healthz 與 SmilePay callback 外的所有 dashboard 路由都會回 503，且 SPA 無法載入。
# 部署前務必設定，否則管理面板會鎖住。
DASHBOARD_USER=
DASHBOARD_PASS=

# SmilePay
SMILEPAY_ENV=test
SMILEPAY_DCVC=
SMILEPAY_RVG2C=
SMILEPAY_VERIFY_KEY=
SMILEPAY_ROTURL=http://localhost:3000/api/payment/callback
# SmilePay 商家驗證參數（後台「商家驗證參數／驗證參數」）。
# ⚠️ 實測：本商家帳號的 SmilePay 超商代碼回呼送出的 Mid_smilepay 為「空字串」，
# 因此一旦填入本參數，callback 會因缺簽章而被 fail-closed 拒絕、真實付款無法標記完成。
# 請保持「空白」，付款改以金額比對驗證。除非你先做一筆測試付款、確認新的 callback log
# 確實含有非空且正確的 Mid_smilepay，才可填入本參數啟用簽章驗證。
SMILEPAY_MERCHANT_VERIFY_PARAM=
