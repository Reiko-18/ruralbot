generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Guild {
  id        String   @id
  name      String
  prefix    String   @default("!")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members Member[]

  @@map("guilds")
}

model Member {
  id        String   @id @default(cuid())
  discordId String   @map("discord_id")
  guildId   String   @map("guild_id")
  username  String
  xp        Int      @default(0)
  level     Int      @default(1)
  coins     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([discordId, guildId])
  @@map("members")
}

model LogConfig {
  id         String   @id @default(cuid())
  channelId  String   @unique @map("channel_id")
  webhookUrl String   @map("webhook_url")
  minLevel   Int      @default(30) @map("min_level")
  label      String?
  isEnabled  Boolean  @default(true) @map("is_enabled")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("log_configs")
}

model SystemHealth {
  id       Int      @id @default(1)
  lastPing DateTime @default(now()) @map("last_ping")
  status   String   @default("OK")

  @@map("system_health")
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]

  @@map("categories")
}

model Product {
  id            String   @id @default(cuid())
  name          String   @unique
  cost          Float
  price         Float
  source        String?
  categoryId    String   @map("category_id")
  faceValue     Float?   @map("face_value")
  costDiscount  Float?   @map("cost_discount")
  priceDiscount Float?   @map("price_discount")

  category Category @relation(fields: [categoryId], references: [id])
  orders   Order[]

  @@map("products")
}

model Order {
  id          String   @id
  productId   String?  @map("product_id")
  productName String   @map("product_name")
  quantity    Int      @default(1)
  actualPrice Float    @map("actual_price")
  actualCost  Float    @map("actual_cost")
  profit      Float
  isCustom    Boolean  @default(false) @map("is_custom")
  createdAt   DateTime @default(now()) @map("created_at")

  product Product? @relation(fields: [productId], references: [id])

  @@map("orders")
}

model AccountingConfig {
  id        String   @id @default(cuid())
  guildId   String   @unique @map("guild_id")
  channelId String   @map("channel_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("accounting_configs")
}

model BotConfig {
  id             Int      @id @default(1)
  primaryGuildId String   @map("primary_guild_id")
  syncChannelId  String   @map("sync_channel_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("bot_configs")
}
