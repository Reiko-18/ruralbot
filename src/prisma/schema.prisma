generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Guild {
  id        String   @id
  name      String
  prefix    String   @default("!")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members Member[]

  @@map("guilds")
}

model Member {
  id        String   @id @default(cuid())
  discordId String   @map("discord_id")
  guildId   String   @map("guild_id")
  username  String
  xp        Int      @default(0)
  level     Int      @default(1)
  coins     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([discordId, guildId])
  @@map("members")
}

model LogConfig {
  id         String   @id @default(cuid())
  channelId  String   @unique @map("channel_id")
  webhookUrl String   @map("webhook_url")
  minLevel   Int      @default(30) @map("min_level")
  label      String?
  isEnabled  Boolean  @default(true) @map("is_enabled")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("log_configs")
}

model SystemHealth {
  id       Int      @id @default(1)
  lastPing DateTime @default(now()) @map("last_ping")
  status   String   @default("OK")

  @@map("system_health")
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]

  @@map("categories")
}

model Product {
  id            String   @id @default(cuid())
  name          String   @unique
  cost          Float
  price         Float
  source        String?
  categoryId    String   @map("category_id")
  faceValue     Float?   @map("face_value")
  costDiscount  Float?   @map("cost_discount")
  priceDiscount Float?   @map("price_discount")

  category Category @relation(fields: [categoryId], references: [id])
  orders   Order[]

  @@map("products")
}

model Order {
  id          String   @id
  productId   String?  @map("product_id")
  productName String   @map("product_name")
  quantity    Int      @default(1)
  actualPrice Float    @map("actual_price")
  actualCost  Float    @map("actual_cost")
  profit      Float
  isCustom    Boolean  @default(false) @map("is_custom")
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String?  @map("created_by")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?  @map("deleted_by")

  product Product?         @relation(fields: [productId], references: [id])
  tickets TicketInstance[]

  @@index([createdAt])
  @@index([productId])
  @@map("orders")
}

model AccountingConfig {
  id        String   @id @default(cuid())
  guildId   String   @unique @map("guild_id")
  channelId String   @map("channel_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("accounting_configs")
}

model BotConfig {
  id                   Int      @id @default(1)
  primaryGuildId       String   @map("primary_guild_id")
  syncChannelId        String   @map("sync_channel_id")
  ticketLogChannelId   String?  @map("ticket_log_channel_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("bot_configs")
}

model PriceNode {
  id        String      @id @default(cuid())
  name      String
  content   String?     @db.Text
  imageUrl       String?     @map("image_url")
  embedSettings  String?     @map("embed_settings") @db.Text
  parentId       String?     @map("parent_id")
  order          Int         @default(0)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  parent    PriceNode?  @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  PriceNode[] @relation("MenuHierarchy")
  items     PriceItem[]

  @@map("price_nodes")
}

model PriceItem {
  id        String    @id @default(cuid())
  label     String
  price     String
  nodeId    String    @map("node_id")
  order     Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  node      PriceNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@map("price_items")
}

model PresenceText {
  id        String   @id @default(cuid())
  text      String
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("presence_texts")
}

model PriceListConfig {
  id          Int      @id @default(1)
  title       String   @default("")
  description String?  @db.Text
  imageUrl       String?  @map("image_url")
  embedSettings  String?  @map("embed_settings") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("price_list_configs")
}

model TicketConfig {
  id               String   @id @default(cuid())
  guildId          String   @unique @map("guild_id")
  panelChannelId   String?  @map("panel_channel_id")
  panelMessageId   String?  @map("panel_message_id")
  logChannelId     String?  @map("log_channel_id")
  categoryOpenId   String?  @map("category_open_id")
  categoryCloseId  String?  @map("category_close_id")
  panelComponentType String @default("buttons") @map("panel_component_type")
  panelEmbed       String?  @db.Text @map("panel_embed")
  defaultMessage   String?  @db.Text @map("default_message")
  lastTicketNum    Int      @default(0) @map("last_ticket_num")
  autoRemindHours  Int?     @map("auto_remind_hours")
  autoCloseHours   Int?     @map("auto_close_hours")
  blacklistMode    String   @default("ephemeral") @map("blacklist_mode")
  blacklistMessage String?  @db.Text @map("blacklist_message")
  transcriptTarget     String   @default("both") @map("transcript_target")
  transcriptLogMessage String?  @db.Text @map("transcript_log_message")
  transcriptDmMessage  String?  @db.Text @map("transcript_dm_message")
  maxOpenPerUser       Int?     @map("max_open_per_user")
  openCooldownSeconds  Int?     @map("open_cooldown_seconds")
  channelNameFormat    String?  @map("channel_name_format")
  supportRoleIds       String?  @db.Text @map("support_role_ids")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  buttonTypes TicketButtonType[]
  blacklist   TicketBlacklist[]
  instances   TicketInstance[]

  @@map("ticket_configs")
}

model TicketButtonType {
  id              String   @id @default(cuid())
  configId        String   @map("config_id")
  label           String
  emoji           String?
  style           String   @default("PRIMARY")
  categoryOpenId  String?  @map("category_open_id")
  categoryCloseId String?  @map("category_close_id")
  welcomeMessage  String?  @db.Text @map("welcome_message")
  embedSettings   String?  @db.Text @map("embed_settings")
  notifyRoleIds   String?  @db.Text @map("notify_role_ids")
  autoRemindHours Int?     @map("auto_remind_hours")
  autoCloseHours  Int?     @map("auto_close_hours")
  maxOpenPerUser  Int?     @map("max_open_per_user")
  cooldownSeconds Int?     @map("cooldown_seconds")
  questions       String?  @db.Text
  order           Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  config    TicketConfig     @relation(fields: [configId], references: [id], onDelete: Cascade)
  instances TicketInstance[]

  @@map("ticket_button_types")
}

model TicketBlacklist {
  id        String   @id @default(cuid())
  configId  String   @map("config_id")
  userId    String   @map("user_id")
  reason    String?
  addedBy   String   @map("added_by")
  createdAt DateTime @default(now()) @map("created_at")

  config TicketConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, userId])
  @@map("ticket_blacklists")
}

model TicketInstance {
  id             String    @id @default(cuid())
  configId       String    @map("config_id")
  buttonTypeId   String?   @map("button_type_id")
  channelId      String    @unique @map("channel_id")
  creatorId      String    @map("creator_id")
  ticketNum      Int       @map("ticket_num")
  status         String    @default("OPEN")
  orderId        String?   @map("order_id")
  claimedById    String?   @map("claimed_by_id")
  locked         Boolean   @default(false)
  closeReason    String?   @db.Text @map("close_reason")
  formAnswers     String?   @db.Text @map("form_answers")
  closedById     String?   @map("closed_by_id")
  lastActivityAt DateTime  @default(now()) @map("last_activity_at")
  reminded       Boolean   @default(false)
  createdAt      DateTime  @default(now()) @map("created_at")
  closedAt       DateTime? @map("closed_at")

  config     TicketConfig      @relation(fields: [configId], references: [id])
  buttonType TicketButtonType? @relation(fields: [buttonTypeId], references: [id], onDelete: SetNull)
  order      Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([configId, status])
  @@index([creatorId])
  @@map("ticket_instances")
}

model PaymentConfig {
  id        String   @id @default(cuid())
  guildId   String   @unique @map("guild_id")
  dcvc      String?
  rvg2c     String?
  verifyKey String?  @map("verify_key") @db.Text
  enabled          Boolean  @default(true)
  feeFamily        Int?     @map("fee_family")
  fee711           Int?     @map("fee_711")
  fee711Over       Int?     @map("fee_711_over")
  fee711Threshold  Int?     @map("fee_711_threshold")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("payment_configs")
}

model PaymentTransaction {
  id              String   @id @default(cuid())
  guildId         String   @map("guild_id")
  orderId         String   @unique @map("order_id")
  amount          Int
  status          String   @default("PENDING")
  payerName       String?  @map("payer_name")
  payerEmail      String?  @map("payer_email")
  payerPhone      String?  @map("payer_phone")
  remark          String?  @db.Text
  smilePayNo      String?  @map("smilepay_no")
  paymentCode     String?  @map("payment_code")
  paymentDeadline DateTime? @map("payment_deadline")
  completedAt     DateTime? @map("completed_at")
  originalAmount  Int?      @map("original_amount")
  feeAmount       Int?      @map("fee_amount")
  paymentStore    String?   @map("payment_store")
  channelId       String?   @map("channel_id")
  messageId       String?   @map("message_id")
  userId          String?   @map("user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  callbackLogs    PaymentCallbackLog[]

  @@index([guildId])
  @@index([status])
  @@map("payment_transactions")
}

model PaymentCallbackLog {
  id            String   @id @default(cuid())
  transactionId String   @map("transaction_id")
  transaction   PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  rawData       String   @map("raw_data") @db.Text
  sourceIp      String?  @map("source_ip")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("payment_callback_logs")
}
