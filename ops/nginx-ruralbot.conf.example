# Nginx 反向代理範本 - RuralBot Dashboard
#
# 使用方式：
#   sudo cp nginx-ruralbot.conf.example /etc/nginx/sites-available/ruralbot
#   sudo ln -sfn /etc/nginx/sites-available/ruralbot /etc/nginx/sites-enabled/ruralbot
#   sudo nginx -t && sudo systemctl reload nginx
#
# 說明：
#   將指定 IP / 網域的 HTTP 請求反代到 RuralBot dashboard，預設服務埠為 3000。
#   若同一台主機還有其他站台，請不要讓其他 default_server 同時吃掉這裡的 server_name。
server {
    listen 80;
    server_name 211.22.158.125 192.168.254.84 localhost 127.0.0.1;

    client_max_body_size 25M;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
